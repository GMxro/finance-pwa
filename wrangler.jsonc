{
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/wrangler.jsonc",
  "name": "finance-pwa",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Vite + @cloudflare/vite-plugin compila el cliente en dist/client.
    // Nunca apuntar a ./dist: ahí pueden quedar restos de builds viejos.
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Wrangler 3.x sólo admite boolean aquí; el Worker deriva los assets al binding.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance-pwa",
      "database_id": "a02dab92-d9c0-4959-8b1b-ff0685cf554f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DELETION_JOURNAL",
      "bucket_name": "finance-pwa-deletion-journal"
    }
  ],
  "vars": {
    "SYNC_EPOCH": "4486eb6b-23fd-433e-b3a8-22b5e2a8e922",
    "BETTER_AUTH_URL": "https://finance-pwa.audioideas.workers.dev",
    "MIN_APP_VERSION": "0.1.1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false
    }
  }
}
