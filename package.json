{
  "name": "finance-pwa",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vite build && node scripts/stamp-service-worker.mjs && tsc --noEmit",
    "postbuild": "node -e \"require('node:fs').rmSync('dist/finance_pwa/.dev.vars',{force:true})\" && node scripts/check-pwa-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply finance-pwa --local",
    "db:migrate:remote": "wrangler d1 migrations apply finance-pwa --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "better-auth": "^1.0.0",
    "dexie": "^4.0.0",
    "hono": "^4.6.0",
    "lucide-react": "^1.63.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-pool-workers": "^0.4.0",
    "@cloudflare/workers-types": "^4.20241001.0",
    "@eslint/js": "^9.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.1.0",
    "vitest": "1.5.3",
    "wrangler": "^3.80.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
